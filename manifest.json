{
  "manifest_version": 3,
  "name": "YANSII Free \u2014 Passive Security Scanner",
  "short_name": "YANSII",
  "version": "2.2.0",
  "description": "Passive web security scanner: header/cookie/CORS audit, XSS & injection indicators, crawler, dashboard. Authorized testing only.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "sidePanel",
    "webRequest",
    "tabs",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/injected.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "devtools_page": "src/devtools.html",
  "commands": {
    "quick-scan": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Scan current page"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Open YANSII Dashboard"
    }
  },
  "minimum_chrome_version": "110"
}